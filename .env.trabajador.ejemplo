# Variables del trabajador de subidas (I10b). Copiar a `.env.trabajador` en el
# servidor y rellenar la clave. NO se versiona (esta en .gitignore).
#
# Ojo: el trabajador corre en el HOST, no en el contenedor. `localhost` y
# `127.0.0.1` son el servidor; `host.docker.internal` solo existe dentro de
# Docker y no sirve aqui.

# LiteLLM del host (el proxy que ya usa la API).
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=sk-cambiar
TEAMS_LLM_MODELO=qwen3.8-27b

# Embeddings de bge-m3 (llama-server del host, puerto 8081). En el .env del
# compose apunta a host.docker.internal; aqui tiene que ser 127.0.0.1.
TEAMS_EMBED_BASE_URL=http://127.0.0.1:8081/v1
TEAMS_EMBED_MODELO=bge-m3

# Los 4 modelos de pyannote ya estan en la cache local. Sin red, esto evita
# que huggingface_hub intente contactar y falle antes de usar la cache.
HF_HUB_OFFLINE=1
