# =========================================================================
#  PORTAL — punto de entrada único vía túnel SSH
#  Este bloque es INDEPENDIENTE del que ya tienes para vcenter-agent
#  (puerto 5000). No lo modifica ni interfiere con él: ambos pueden
#  convivir en el mismo Nginx sin conflicto porque escuchan en puertos
#  distintos.
# =========================================================================

server {
    listen 8443 ssl;
    server_name _;

    # Reutiliza el mismo certificado que ya usas para vcenter-agent,
    # o genera uno propio si prefieres separarlos.
    ssl_certificate     /home/agent/vcenter_agent_system/ssl/cert.pem;
    ssl_certificate_key /home/agent/vcenter_agent_system/ssl/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # --- Portal estático (index.html con el router de tarjetas) ---
    root /var/www/portal;
    index index.html;

    location = / {
        root /var/www/portal;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files /index.html =404;
    }
    
    location / {
        try_files $uri $uri/ =404;
    }

    # --- Ejemplo: infografías estáticas servidas bajo /infografias/ ---
    location /infografias/ {
        alias /var/www/infografias/;
        try_files $uri $uri/ =404;
    }

    location /logs/stream {
        proxy_pass http://127.0.0.1:9500/logs/stream;
        proxy_http_version 1.1;

        # Igual que ya haces con /chat/stream en vcenter-agent:
        # sin esto, Nginx acumula el output y no llega en tiempo real.
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location /app1/ {
        proxy_pass http://127.0.0.1:4001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }

    location /app2/ {
        proxy_pass http://127.0.0.1:8001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }

    location /app3/ {
        proxy_pass http://127.0.0.1:9090/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }

    location /app4/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }

    location /grafana/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==========================================================
    # APP5 - Memoria del equipo
    # ==========================================================

    location /app5/ {
        proxy_pass http://127.0.0.1:8080/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # La app no sabe que vive bajo /app5/ (nginx le quita el prefijo), asi
        # que al redirigir al login no sabria a donde volver. Esta cabecera se
        # lo dice para que el `next` sea /app5/ y no / (que es el portal).
        proxy_set_header X-Forwarded-Prefix /app5;
    }

    # CSS de app5
    location /css/ {
        proxy_pass http://127.0.0.1:8080/css/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # JavaScript de app5
    location /js/ {
        proxy_pass http://127.0.0.1:8080/js/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Favicon de app5
    location = /favicon.svg {
        proxy_pass http://127.0.0.1:8080/favicon.svg;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API de app5
    location /api/ {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Subidas (I10b): los .wav se mandan por trozos de 16 MB, pero se deja
        # margen por si un dia se sube el tamano del trozo. Sin esto Nginx
        # corta con un 413 que el navegador no puede explicar.
        client_max_body_size 64m;
        # No acumular el cuerpo en un fichero temporal antes de reenviarlo: la
        # API va escribiendo el .part segun llega y el progreso se ve antes.
        proxy_request_buffering off;
        # El chat y el progreso de las subidas son SSE: sin esto Nginx los
        # acumula y llegan de golpe al terminar. El timeout largo cubre una
        # transcripcion que puede estar horas en cola sin cerrar la conexion.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    
    #subpaginas. `proxy_pass` SIN barra final: asi Nginx reenvia la ruta
    # completa (/acciones.html). Con la barra final la sustituye por "/" y la
    # app devolveria el index en vez de la subpagina.
    location = /acciones.html {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /reservas/ {
    # nginx envía el prefijo en X-Forwarded-Prefix y recorta "/reservas/"
    # al hacer proxy_pass con URI ("/"). La app usa rutas relativas, así
    # que el frontend funciona sin más reescritura.
        proxy_pass http://127.0.0.1:8600/;
        proxy_set_header Host $host;
    	proxy_set_header X-Real-IP $remote_addr;
    	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    	proxy_set_header X-Forwarded-Proto $scheme;
    	proxy_set_header X-Forwarded-Prefix /reservas;
    }


    # ==========================================================
    # CI/CD GALTTCMC - Web UI (Flask + Gunicorn en 172.30.188.137:8080, HTTP)
    #
    # Montada bajo el prefijo /cicd/ para seguir usando UN solo puerto
    # reenviado (8443). La clave es la pareja:
    #   - proxy_pass con URI "/" al final  -> Nginx QUITA el prefijo, de modo
    #     que Flask sigue viendo rutas raiz (/login, /api/..., /static/...).
    #   - X-Forwarded-Prefix: /cicd        -> ProxyFix en web/app.py lo
    #     convierte en SCRIPT_NAME, y url_for() devuelve /cicd/... .
    # Sin X-Forwarded-Prefix los enlaces y redirecciones apuntarian a / y
    # caeran en el location / del portal (404).
    # ==========================================================

    location = /cicd {
        return 301 /cicd/;
    }

    location /cicd/ {
        proxy_pass http://172.30.188.137:8080/;
        proxy_http_version 1.1;

        # $http_host conserva el puerto (8443) para que la app genere
        # URLs/cookies coherentes con lo que ve el navegador.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /cicd;

        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        # El visor de logs hace live-tail por polling (no SSE), asi que el
        # buffering se deja activado. habrlo si algun dia se pasa a SSE:
        #   proxy_buffering off; proxy_cache off; proxy_read_timeout 3600s;
    }

    #subpaginas. Sin barra final: reenvia /buscar.html tal cual (ver acciones).
    location = /buscar.html {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    #subpaginas. Sin barra final: reenvia /chat.html tal cual (ver acciones).
    location = /chat.html {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Login de app5. El middleware de la app redirige aqui (303) cuando falta
    # la sesion, asi que tiene que llegar hasta ella tambien a traves del
    # portal; sin este bloque caeria en el `location /` del portal (404).
    location = /login.html {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vista de una reunion. Faltaba: los enlaces del timeline apuntan a
    # /reunion.html?uid=... y sin esto daban 404 al pasar por el portal.
    location = /reunion.html {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Subida de grabaciones (I10b). Mismo patron que las otras subpaginas:
    # los enlaces del menu apuntan a /subir.html y sin esto darian 404.
    location = /subir.html {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /prometheus/ {
        proxy_pass http://127.0.0.1:9090/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8001/static/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    } 

    location /api/v1/ {
        proxy_pass http://127.0.0.1:8001/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==========================================================
    # vCenter Agent System — 172.30.188.140:5000 (HTTPS)
    # ==========================================================

    location /vcenter/ {
        proxy_pass https://172.30.188.140:5000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSL verification disabled (self-signed cert)
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        proxy_read_timeout 120s;
    }

    # SSE chat stream — vCenter
    location /vcenter/chat/stream {
        proxy_pass https://172.30.188.140:5000/chat/stream;
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "keep-alive";
        proxy_read_timeout 300s;

        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    }

    # SSE admin logs — vCenter
    location /vcenter/api/admin/logs/stream {
        proxy_pass https://172.30.188.140:5000/api/admin/logs/stream;
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "keep-alive";
        proxy_read_timeout 3600s;

        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    }

    # Reports generate — vCenter
    location /vcenter/api/admin/reports/generate {
        proxy_pass https://172.30.188.140:5000/api/admin/reports/generate;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 960s;
        proxy_send_timeout 960s;

        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    }

    # Recursos estáticos del vCenter (CSS, JS, imágenes)
    location /vcenter/static/ {
        proxy_pass https://172.30.188.140:5000/static/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    } 
    # --- Ejemplo: otra app corriendo en un puerto interno (3001) ---
    # Descomenta y ajusta el puerto según cada servicio nuevo.
    #
    # location /app2/ {
    #     proxy_pass http://127.0.0.1:3001/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    #
    # Si esa app usa WebSockets, añade también:
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "upgrade";
}

