# Plantilla de configuracion local. Copiala a `.env`, que NO se versiona.
#
#     cp .env.ejemplo .env

# Ruta del proyecto en ESTA maquina, tal como aparece dentro de meetings.db.
# La API la usa para traducir las rutas absolutas de audio y transcripcion
# guardadas por el pipeline a las de dentro del contenedor (/app).
#
# En el servidor Linux:
TEAMS_RAIZ_ORIGEN=/home/usuario/teams_transcript
#
# En Windows seria algo como (sin comillas, con barras invertidas):
# TEAMS_RAIZ_ORIGEN=C:\Users\usuario\Documents\teams_transcript

# Clave del proxy LiteLLM, que usa el chat (fase I5). Nunca en la imagen ni
# en el repo: solo aqui. Dejala vacia si hablas con `llama-server` directo,
# que no pide ninguna: entonces la peticion sale sin cabecera Authorization.
LITELLM_API_KEY=

# Donde escucha el modelo de CHAT, visto DESDE EL CONTENEDOR. `localhost` ahi
# dentro es el propio contenedor, no el host, por eso el alias.
#
# Con un proxy LiteLLM delante:
# LITELLM_BASE_URL=http://host.docker.internal:4000/v1
#
# Con `llama-server` directo (sin proxy), el puerto del modelo de chat:
# LITELLM_BASE_URL=http://host.docker.internal:8000/v1

# Donde escuchan los EMBEDDINGS, si no es el mismo sitio. Con LiteLLM delante
# no hace falta (los dos salen de la misma URL); con dos `llama-server`
# sueltos, cada modelo tiene su puerto y hay que separarlos.
# TEAMS_EMBED_BASE_URL=http://host.docker.internal:8085/v1

# Modelos. Con LiteLLM tienen que coincidir con un `model_name` suyo; para
# verlos:  curl http://localhost:4000/v1/models -H "Authorization: Bearer <key>"
# Con `llama-server` el nombre da igual: sirve el modelo que tenga cargado.
# TEAMS_LLM_MODELO=qwen3.8-27b
# TEAMS_EMBED_MODELO=bge-m3

# Prefijos de tarea del modelo de embeddings, si el que uses los exige.
# bge-m3 NO los lleva. nomic quiere search_document:/search_query:, e5 quiere
# passage:/query:. Cambiarlos obliga a reconstruir el indice.
# TEAMS_EMBED_PREFIJO=
# TEAMS_EMBED_PREFIJO_CONSULTA=
