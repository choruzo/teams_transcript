/.venv
/grabaciones
# Staging de las subidas (I10b): son .part de cientos de MB, nunca al repo.
/subidas/
__pycache__/

# Datos de reuniones: no se versionan. La plantilla del glosario si.
# Se ignora el CONTENIDO de datos/ (no el directorio) para poder excluir
# glosario.ejemplo.md: git no reincluye ficheros dentro de un directorio
# ignorado.
/datos/*
!/datos/glosario.ejemplo.md
/salida_con_glosario/*

# Paquete de exportacion de la imagen Docker (docker/exportar.ps1): son
# cientos de MB regenerables desde el Dockerfile.
/dist/

# Configuracion local del despliegue: rutas de esta maquina y la clave de
# LiteLLM. La plantilla versionada es .env.ejemplo.
.env
.env.trabajador

.claude/*
imagen/imagen.png
.gitignore

# Copias temporales de pruebas locales (nunca versionar bases reales)
.tmp_i11/
